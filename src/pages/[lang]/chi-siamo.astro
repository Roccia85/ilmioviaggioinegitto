---
/**
 * Chi siamo — agenzia + guida Abdelrahim (design: chi-siamo.html).
 * page-hero · box guida · griglia "valori" · CTA. Genera /it/chi-siamo e /en/chi-siamo.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizePath, languages, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// [DA COMPLETARE] foto reale — placeholder dal design.
const HERO_IMG =
  'https://images.unsplash.com/photo-1679058616751-2b91ee543913?w=1700&q=72&auto=format&fit=crop';
const homeHref = localizePath('/', lang);
const contactHref = localizePath('/contatti', lang);
---
<BaseLayout lang={lang} title={t('seo.about.title')} description={t('seo.about.description')} solidHeader>
  {/* ===== PAGE HERO ===== */}
  <section class="page-hero">
    <img src={HERO_IMG} alt="" />
    <div class="container">
      <div class="crumbs"><a href={homeHref}>{t('nav.home')}</a><span>·</span><span>{t('about.crumb')}</span></div>
      <span class="eyebrow" style="color:var(--gold-300)">{t('about.hero.eyebrow')}</span>
      <h1>{t('about.hero.title')}</h1>
      <p class="lead">{t('about.hero.lead')}</p>
    </div>
  </section>

  {/* ===== GUIDE ===== */}
  <section class="section guide" style="background:var(--paper)">
    <div class="container wrap">
      <div class="portrait reveal">
        {/* [DA COMPLETARE] foto reale della guida */}
        <div class="img" style="background:linear-gradient(150deg,var(--nile-700),var(--nile-900));display:grid;place-items:center;text-align:center;color:rgba(255,255,255,.6)">
          <div style="padding:24px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" style="width:46px;height:46px;margin:0 auto 12px"><circle cx="12" cy="9" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
            <div style="font-family:var(--serif);font-size:34px;color:#fff;line-height:1.1">Abdelrahim</div>
            <div style="font-size:12px;letter-spacing:.18em;text-transform:uppercase;margin-top:8px;color:var(--gold-300)">{t('about.guide.photoLabel')}</div>
          </div>
        </div>
        <div class="badge"><b>★</b><span>{t('about.guide.badge')}</span></div>
      </div>
      <div class="reveal">
        <span class="eyebrow">{t('about.guide.eyebrow')}</span>
        <h2>{t('about.guide.title')}</h2>
        <p>{t('about.guide.p1')}</p>
        <p>{t('about.guide.p2')}</p>
        <div class="langs">
          <span class="chip"><i></i> {t('common.langIt')}</span>
          <span class="chip"><i></i> {t('common.langEn')}</span>
          <span class="chip"><i></i> {t('common.langAr')}</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== VALUES ===== */}
  <section class="section" style="background:var(--sand-50)">
    <div class="container">
      <div class="section-head center reveal" style="margin:0 auto 40px">
        <span class="eyebrow center">{t('about.values.eyebrow')}</span>
        <h2>{t('about.values.title')}</h2>
      </div>
      <div class="vals reveal">
        <div class="val-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold-600)" stroke-width="1.6"><path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z" /><path d="m9 12 2 2 4-4" /></svg>
          <h3>{t('about.values.val1.title')}</h3>
          <p>{t('about.values.val1.text')}</p>
        </div>
        <div class="val-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold-600)" stroke-width="1.6"><path d="M5 8h14v9H9l-4 3V8Z" /><path d="M9 12h6M9 14.5h3" /></svg>
          <h3>{t('about.values.val2.title')}</h3>
          <p>{t('about.values.val2.text')}</p>
        </div>
        <div class="val-card">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold-600)" stroke-width="1.6"><path d="M12 3a6 6 0 0 1 6 6c0 4-6 12-6 12S6 13 6 9a6 6 0 0 1 6-6Z" /><circle cx="12" cy="9" r="2" /></svg>
          <h3>{t('about.values.val3.title')}</h3>
          <p>{t('about.values.val3.text')}</p>
        </div>
      </div>
      <div class="center reveal" style="margin-top:40px">
        <a class="btn btn-primary btn-lg" href={contactHref}>{t('about.values.cta')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
