---
/**
 * Home — pagina SEGNAPOSTO (tappa scaffold).
 * Serve solo a verificare layout, header (trasparente sopra l'hero),
 * footer e cambio lingua. I contenuti definitivi (trust band, box guida,
 * preview articoli, CTA band) arriveranno nelle tappe successive.
 *
 * Routing i18n: una sola pagina genera /it e /en via getStaticPaths.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, languages, type Lang } from '../../i18n/utils';
import { waLink } from '../../config';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<BaseLayout lang={lang}>
  <section class="hero">
    <div class="hero-media">
      <img
        src="https://images.unsplash.com/photo-1662567819563-0a5bf182f3a8?w=1900&q=72&auto=format&fit=crop"
        alt={lang === 'it' ? 'Tempio di Karnak, Luxor' : 'Karnak Temple, Luxor'}
      />
    </div>
    <div class="container hero-inner">
      <span class="eyebrow">{t('home.eyebrow')}</span>
      <h1>{t('home.title')}</h1>
      <p class="lead">{t('home.lead')}</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={waLink} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.5c-.2.2-.3.3-.2.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6 0 .2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.6.8 1.9.9.3.2.5.2.5.4.1.1.1.6-.1 1.3Z" /></svg>
          {t('home.ctaPrimary')}
        </a>
        <a class="btn btn-ghost btn-lg" href="#main">{t('home.ctaSecondary')}</a>
      </div>
    </div>
    <div class="scroll-cue"><span>{t('home.scroll')}</span><i></i></div>
  </section>

  <section class="section">
    <div class="container center section-head reveal">
      <span class="eyebrow center">Scaffold</span>
      <h2>{t('brand.name')} {t('brand.tagline')}</h2>
      <p>{t('home.scaffoldNote')}</p>
    </div>
  </section>
</BaseLayout>
