---
/**
 * Home — versione completa (design: home.html).
 * Hero · trust band · box guida Abdelrahim · anteprima ultimi articoli (helper)
 * · CTA band. Una sola pagina genera /it e /en.
 *
 * NB: il design non prevede una sezione "Escursioni" in home (rimossa dal
 * cliente in Tappa 2 a favore delle storie Instagram) — vedi PROGRESS.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { useTranslations, localizePath, languages, type Lang } from '../../i18n/utils';
import { waLink } from '../../config';
import { getPublishedArticles } from '../../lib/articles';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Immagini di sfondo — placeholder dal design (foto reali = [DA COMPLETARE]).
const HERO_IMG =
  'https://images.unsplash.com/photo-1662567819563-0a5bf182f3a8?w=1900&q=72&auto=format&fit=crop';
const CTA_IMG =
  'https://images.unsplash.com/photo-1679058616751-2b91ee543913?w=1600&q=72&auto=format&fit=crop';

const latest = (await getPublishedArticles(lang)).slice(0, 3);
const aboutHref = localizePath('/chi-siamo', lang);
const articlesHref = localizePath('/articoli', lang);
const contactHref = localizePath('/contatti', lang);
---
<BaseLayout lang={lang} title={t('seo.home.title')} description={t('seo.home.description')}>
  {/* ===== HERO ===== */}
  <section class="hero">
    <div class="hero-media">
      <img src={HERO_IMG} alt={lang === 'it' ? 'Tempio di Karnak, Luxor' : 'Karnak Temple, Luxor'} />
    </div>
    <div class="container hero-inner">
      <span class="eyebrow">{t('home.hero.eyebrow')}</span>
      <h1>{t('home.hero.title')}</h1>
      <p class="lead">{t('home.hero.lead')}</p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={waLink} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.5c-.2.2-.3.3-.2.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6 0 .2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.6.8 1.9.9.3.2.5.2.5.4.1.1.1.6-.1 1.3Z" /></svg>
          {t('home.hero.ctaPrimary')}
        </a>
        <a class="btn btn-ghost btn-lg" href={aboutHref}>{t('home.hero.ctaSecondary')}</a>
      </div>
    </div>
    <div class="scroll-cue"><span>{t('home.hero.scroll')}</span><i></i></div>
  </section>

  {/* ===== TRUST BAND ===== */}
  <section class="trust">
    <div class="container">
      <div class="grid">
        <div class="item">
          <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 4 6 9v9c0 8.5 5.8 14.3 14 18 8.2-3.7 14-9.5 14-18V9L20 4Z" /><path d="m14.5 20 4 4 7.5-8" stroke-width="2" /></svg>
          <div>
            <h3>{t('home.trust.item1.title')}</h3>
            <p>{t('home.trust.item1.text')}</p>
          </div>
        </div>
        <div class="item">
          <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="20" cy="16" r="8" /><path d="m15 22-2.5 12 7.5-4 7.5 4L25 22" /><path d="m16.5 16 2.5 2.5 4.5-5" stroke-width="2" /></svg>
          <div>
            <h3>{t('home.trust.item2.title')}</h3>
            <p>{t('home.trust.item2.text')}</p>
          </div>
        </div>
        <div class="item">
          <svg class="ic" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9h28v18H22l-6 6v-6H6V9Z" /><path d="M13 16h14M13 21h9" /></svg>
          <div>
            <h3>{t('home.trust.item3.title')}</h3>
            <p>{t('home.trust.item3.text')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== GUIDE / ABDELRAHIM ===== */}
  <section class="section guide">
    <div class="container wrap">
      <div class="portrait reveal">
        {/* [DA COMPLETARE] foto reale della guida — segnaposto come nel design */}
        <div class="img" style="background:linear-gradient(150deg,var(--nile-700),var(--nile-900));display:grid;place-items:center;text-align:center;color:rgba(255,255,255,.6)">
          <div style="padding:24px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" style="width:46px;height:46px;margin:0 auto 12px"><circle cx="12" cy="9" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
            <div style="font-family:var(--serif);font-size:34px;color:#fff;line-height:1.1">Abdelrahim</div>
            <div style="font-size:12px;letter-spacing:.18em;text-transform:uppercase;margin-top:8px;color:var(--gold-300)">{t('home.guide.photoLabel')}</div>
          </div>
        </div>
        <div class="badge">
          <b>{t('home.guide.badgeNumber')}</b>
          <span>{t('home.guide.badgeText')}</span>
        </div>
      </div>
      <div class="reveal">
        <span class="eyebrow">{t('home.guide.eyebrow')}</span>
        <h2>{t('home.guide.title')}</h2>
        <p>{t('home.guide.p1')}</p>
        <div class="langs">
          <span class="chip"><i></i> {t('common.langIt')}</span>
          <span class="chip"><i></i> {t('common.langEn')}</span>
          <span class="chip"><i></i> {t('common.langAr')}</span>
        </div>
        <p class="sign">Abdelrahim</p>
        <div style="margin-top:18px">
          <a class="btn btn-dark" href={aboutHref}>{t('home.guide.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  {/* ===== ARTICLES PREVIEW ===== */}
  {latest.length > 0 && (
    <section class="section" style="background:var(--paper)">
      <div class="container">
        <div class="section-head reveal" style="display:flex;justify-content:space-between;align-items:flex-end;max-width:none;gap:20px;flex-wrap:wrap">
          <div style="max-width:560px">
            <span class="eyebrow">{t('home.articlesPreview.eyebrow')}</span>
            <h2>{t('home.articlesPreview.title')}</h2>
          </div>
          <a class="btn btn-outline" href={articlesHref} style="white-space:nowrap">{t('home.articlesPreview.cta')}</a>
        </div>
        <div class="articles reveal">
          {latest.map((article) => <ArticleCard article={article} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  {/* ===== CTA BAND ===== */}
  <section class="cta-band">
    <img src={CTA_IMG} alt="" />
    <div class="container inner reveal">
      <span class="eyebrow" style="color:var(--gold-300)">{t('home.cta.eyebrow')}</span>
      <h2>{t('home.cta.title')}</h2>
      <p>{t('home.cta.text')}</p>
      <div class="cta-row" style="display:flex;gap:14px;flex-wrap:wrap">
        <a class="btn btn-wa btn-lg" href={waLink} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.5c-.2.2-.3.3-.2.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6 0 .2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.6.8 1.9.9.3.2.5.2.5.4.1.1.1.6-.1 1.3Z" /></svg>
          {t('home.cta.waCta')}
        </a>
        <a class="btn btn-ghost btn-lg" href={contactHref}>{t('home.cta.contactsCta')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
