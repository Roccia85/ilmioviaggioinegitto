---
/**
 * Dettaglio articolo (design: articolo.html).
 * page-hero (cover, data, autore) · corpo Markdown · galleria · callout Instagram
 * · condivisione · CTA · articoli correlati. Route per slug+lingua.
 *
 * LangSwitcher: porta alla versione nell'altra lingua se esiste e pubblicata,
 * altrimenti fa fallback alla lista articoli di quella lingua. hreflang (SEO)
 * include l'altra lingua SOLO se la traduzione esiste davvero.
 */
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import {
  getPublishedArticles,
  getArticle,
  getRelatedArticles,
  articleSlug,
  readingTime,
  type Articolo,
} from '../../../lib/articles';
import {
  useTranslations,
  localizePath,
  formatDateNumeric,
  languages,
  type Lang,
} from '../../../i18n/utils';
import { SITE, waLink } from '../../../config';

export async function getStaticPaths() {
  const paths: { params: { lang: Lang; slug: string }; props: { article: Articolo } }[] = [];
  for (const lang of Object.keys(languages) as Lang[]) {
    for (const article of await getPublishedArticles(lang)) {
      paths.push({ params: { lang, slug: articleSlug(article) }, props: { article } });
    }
  }
  return paths;
}

interface Props {
  article: Articolo;
}

const lang = Astro.params.lang as Lang;
const { article } = Astro.props;
const t = useTranslations(lang);

const slug = articleSlug(article);
const { title, excerpt, cover, gallery, date } = article.data;
const { Content } = await render(article);
const minutes = readingTime(article.body);

// Traduzione nell'altra lingua: esiste e pubblicata?
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const translation = await getArticle(slug, otherLang);
const hasTranslation = !!translation && translation.data.draft === false;

const selfHref = localizePath(`/articoli/${slug}`, lang);
const otherHref = hasTranslation
  ? localizePath(`/articoli/${slug}`, otherLang)
  : localizePath('/articoli', otherLang); // fallback alla lista

// nav (LangSwitcher): sempre entrambe le lingue (con fallback).
const langAlternates = { [lang]: selfHref, [otherLang]: otherHref } as Partial<Record<Lang, string>>;
// hreflang (SEO): solo lingue con lo stesso contenuto.
const seoAlternates = {
  [lang]: selfHref,
  ...(hasTranslation ? { [otherLang]: localizePath(`/articoli/${slug}`, otherLang) } : {}),
} as Partial<Record<Lang, string>>;

const articoliHref = localizePath('/articoli', lang);
const related = await getRelatedArticles(slug, lang, 3);
---
<BaseLayout
  lang={lang}
  title={title}
  description={excerpt}
  image={cover}
  solidHeader
  langAlternates={langAlternates}
  seoAlternates={seoAlternates}
>
  {/* ===== ARTICLE HERO ===== */}
  <section class="page-hero" style="padding:140px 0 60px">
    <img src={cover} alt={title} />
    <div class="container" style="max-width:820px">
      <div class="crumbs"><a href={articoliHref}>{t('article.crumb')}</a><span>·</span><span>{title}</span></div>
      <span class="eyebrow" style="color:var(--gold-300)">{formatDateNumeric(date)}</span>
      <h1>{title}</h1>
      <div class="art-author">
        <div class="av">A</div>
        <div class="who">
          <b>{t('article.authorName')}</b>
          <span>{t('article.authorRole')} · {minutes} {t('article.minRead')}</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== ARTICLE BODY ===== */}
  <article class="section" style="padding-top:56px">
    <div class="container">
      <div class="article">
        {excerpt && <p class="lede">{excerpt}</p>}

        <Content />

        {gallery.length > 0 && (
          <>
            <h2>{t('article.galleryTitle')}</h2>
            <div class="art-gallery">
              {gallery.map((src) => <img src={src} alt="" loading="lazy" />)}
            </div>
          </>
        )}

        {/* Instagram callout */}
        <aside class="ig-callout">
          <a class="badge-ring" href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="var(--nile-800)" stroke-width="1.7" style="width:24px;height:24px"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><circle cx="17" cy="7" r="1" fill="var(--nile-800)" stroke="none" /></svg></span>
          </a>
          <div class="txt">
            <b>{t('article.igCallout.title')}</b>
            <p>{t('article.igCallout.text')}</p>
          </div>
          <a class="btn btn-dark" href={SITE.social.instagram} target="_blank" rel="noopener" style="flex:none">{t('article.igCallout.cta')}</a>
        </aside>

        {/* share */}
        <div class="share-row">
          <div class="label">{t('article.shareLabel')}</div>
          <div class="share">
            <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-2.8h-2.8V9.4c0-.8.2-1.4 1.4-1.4h1.5V5.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2H8.3V14h2.6v7h2.6z" /></svg></a>
            <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="3.6" /><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" /></svg></a>
            <a class="wa" href={waLink} target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.2.6.8 2 .9 2.1.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.5c-.2.2-.3.3-.2.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6 0 .2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.6.8 1.9.9.3.2.5.2.5.4.1.1.1.6-.1 1.3Z" /></svg></a>
          </div>
        </div>

        {/* inline CTA */}
        <div class="article-cta">
          <div>
            <h3>{t('article.cta.title')}</h3>
            <p>{t('article.cta.text')}</p>
          </div>
          <a class="btn btn-primary btn-lg" href={waLink} target="_blank" rel="noopener">{t('article.cta.button')}</a>
        </div>
      </div>
    </div>
  </article>

  {/* ===== RELATED ===== */}
  {related.length > 0 && (
    <section class="section" style="background:var(--sand-50);padding-top:56px">
      <div class="container">
        <div class="section-head reveal" style="margin-bottom:30px">
          <span class="eyebrow">{t('article.related.eyebrow')}</span>
          <h2>{t('article.related.title')}</h2>
        </div>
        <div class="articles reveal">
          {related.map((a) => <ArticleCard article={a} lang={lang} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
